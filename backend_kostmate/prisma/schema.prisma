// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(USER)
  transactions Transaction[]
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        String   // "catering", "laundry", "kost"
  description String?
  amount      Float
  status      String   // "paid", "unpaid", "processing"
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}
